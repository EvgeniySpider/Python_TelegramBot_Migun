<file path="docker-compose.yml">
services:
  db:
    image: postgres:16-alpine
    container_name: calendar_bot_db
    restart: always
    environment:
      POSTGRES_DB: ${DB_NAME:-calendar_db}
      POSTGRES_USER: ${DB_USER:-postgres}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-postgres}
    ports:
      - "5444:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      # Используем переменные из .env, чтобы Compose подставил их корректно
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-postgres} -d ${DB_NAME:-calendar_db}"]
      interval: 5s
      timeout: 5s
      retries: 5

  web:
    build:
      context: .
